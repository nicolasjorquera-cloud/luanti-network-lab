# ALTERNATIVE (non-default) quadlet unit.
# The default deployment is the explicit Type=simple systemd unit generated by
# scripts/deploy-luanti-service.sh (reliable on user managers). Use these
# quadlet files only on hosts where podman-system-generator is available.
[Unit]
Description=Luanti game server
After=network-online.target
Wants=network-online.target

[Container]
Pod=luanti.pod
Image=localhost/luanti-network-lab/luanti:latest
ContainerName=luanti

# Persistent data: named world volume (matches luanti.service); config from
# the user's data dir (Quadlet %h expands to the deploying user's $HOME).
Volume=luanti-world:/var/lib/luanti/world:Z
Volume=%h/luanti-data/minetest.conf:/etc/luanti/minetest.conf:ro,Z

# Publish UDP 30000 ONLY to the Tailscale interface of THIS host (zero-trust:
# never LAN, never public Internet — see docs/decisions/ADR-001).
# NOTE: replace 100.64.0.0 with your real Tailscale IP before deploying
# (see scripts/deploy-luanti-service.sh).
PublishPort=100.64.0.0:30000:30000/udp

[Service]
Restart=on-failure
TimeoutStartSec=0

[Install]
WantedBy=default.target
