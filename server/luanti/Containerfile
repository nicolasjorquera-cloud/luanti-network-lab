FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      luanti-server \
      procps \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 30000 --create-home --home /var/lib/luanti luanti \
 && mkdir -p /var/lib/luanti/world \
 && chown -R luanti:luanti /var/lib/luanti

# Mineclonia subgame (Minecraft-like), installed into the server games dir
RUN git clone --depth 1 https://codeberg.org/mineclonia/mineclonia.git \
      /usr/share/luanti/games/mineclonia

USER luanti

# The world is mounted as a volume; config path passed via exec.
VOLUME ["/var/lib/luanti/world"]

ENTRYPOINT ["/usr/games/luantiserver", "--config", "/etc/luanti/minetest.conf", "--world", "/var/lib/luanti/world", "--gameid", "mineclonia", "--logfile", "/var/lib/luanti/world/debug.txt"]
